# GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION: Used to call Gemini via Vertex AI.
# No API key is needed — the server authenticates with Application Default
# Credentials (the Cloud Run service's own service account in production,
# or `gcloud auth application-default login` locally). The service account
# needs the "Vertex AI User" (roles/aiplatform.user) role.
GOOGLE_CLOUD_PROJECT="landing-zone-demo-341118"
GOOGLE_CLOUD_LOCATION="global"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
